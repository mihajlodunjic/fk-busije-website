---
import ClubCrest from "@/components/brand/ClubCrest.astro";
import { business } from "@/data/business";
import { globalCopy } from "@/data/copy";
import { navigationItems } from "@/data/navigation";
import { publicSocialLinks } from "@/data/social";

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;
const instagram = publicSocialLinks.find((link) => link.primary) ?? publicSocialLinks[0];
const instagramAria = `${globalCopy.headerCta} (${globalCopy.externalLinkAriaLabel})`;
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={business.shortName}>
      <ClubCrest alt={business.crest.alt} className="header-crest" loading="eager" size={104} />
      <span class="brand-copy">
        <span class="brand-name">{business.shortName}</span>
        <span class="brand-meta">БУСИЈЕ · ЗЕМУН</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={globalCopy.navAriaLabel}>
      <ul class="nav-list plain-list">
        {
          navigationItems.map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {instagram && (
      <a
        class="header-cta button-link"
        href={instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={instagramAria}
      >
        {globalCopy.headerCta}
      </a>
    )}

    <button
      class="menu-toggle"
      type="button"
      aria-label={globalCopy.mobileMenuOpen}
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
    >
      <span class="menu-toggle-lines" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

</header>

<div class="mobile-panel" id="mobile-navigation" data-mobile-panel aria-hidden="true" inert>
  <nav class="mobile-nav" aria-label={globalCopy.navAriaLabel}>
    <ul class="mobile-nav-list plain-list">
      {
        navigationItems.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mobile-contact">
      {instagram && (
        <a
          class="mobile-follow"
          href={instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={instagramAria}
        >
          {globalCopy.headerCta}
        </a>
      )}
      <a class="mobile-contact-link" href={business.contact.phoneHref}>
        {business.contact.phoneDisplay}
      </a>
    </div>
  </nav>
</div>

<script is:inline>
  const header = document.querySelector("[data-site-header]");

  if (header) {
    const toggleButton = header.querySelector("[data-menu-toggle]");
    const panel = document.querySelector("[data-mobile-panel]");
    const focusableSelector =
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let restoreFocus = false;

    if (toggleButton && panel) {
    const getFocusable = () => {
      const focusable = [toggleButton, ...panel.querySelectorAll(focusableSelector)].filter(Boolean);
      return focusable;
    };

    const syncButtonLabel = (open) => {
      toggleButton.setAttribute("aria-expanded", String(open));
      toggleButton.setAttribute("aria-label", open ? "Затвори мени" : "Отвори мени");
    };

    const closeMenu = ({ focusTrigger = true } = {}) => {
      document.body.classList.remove("menu-open");
      header.classList.remove("menu-active");
      panel.classList.remove("is-open");
      panel.setAttribute("aria-hidden", "true");
      panel.setAttribute("inert", "");
      syncButtonLabel(false);

      if (focusTrigger && restoreFocus) {
        toggleButton.focus();
      }
    };

    const openMenu = () => {
      restoreFocus = document.activeElement === toggleButton;
      document.body.classList.add("menu-open");
      header.classList.add("menu-active");
      panel.classList.add("is-open");
      panel.removeAttribute("inert");
      panel.setAttribute("aria-hidden", "false");
      syncButtonLabel(true);

      const focusable = getFocusable();
      const firstLink = focusable.find((element) => element !== toggleButton);
      if (firstLink) {
        firstLink.focus();
      }
    };

    toggleButton.addEventListener("click", () => {
      const expanded = toggleButton.getAttribute("aria-expanded") === "true";
      if (expanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    panel.addEventListener("click", (event) => {
      if (event.target === panel) {
        closeMenu({ focusTrigger: false });
      }
    });

    panel.querySelectorAll("a[href]").forEach((link) => {
      link.addEventListener("click", () => closeMenu({ focusTrigger: false }));
    });

    document.addEventListener("keydown", (event) => {
      if (toggleButton.getAttribute("aria-expanded") !== "true") {
        return;
      }

      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu();
        return;
      }

      if (event.key !== "Tab") {
        return;
      }

      const focusable = getFocusable();
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (!first || !last) {
        return;
      }

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const syncViewport = () => {
      if (window.innerWidth >= 900) {
        closeMenu({ focusTrigger: false });
      }
    };

    window.addEventListener("resize", syncViewport);
    syncViewport();

    const onScroll = () => {
      if (window.scrollY > 16) {
        header.dataset.scrolled = "true";
      } else {
        header.dataset.scrolled = "false";
      }
    };

    onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 95;
    background: rgba(244, 241, 234, 0.96);
    border-bottom: 1px solid rgba(11, 28, 45, 0.12);
    backdrop-filter: blur(10px);
  }

  .header-inner {
    position: relative;
    z-index: 96;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    column-gap: 24px;
    min-height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    min-width: 44px;
  }

  :global(.header-crest) {
    width: 104px;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 0.95;
  }

  .brand-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .desktop-nav {
    justify-self: end;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-list a,
  .header-cta {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
  }

  .nav-list a[aria-current="page"] {
    color: var(--color-club-blue);
  }

  .header-cta {
    justify-self: end;
  }

  .menu-toggle,
  .mobile-panel {
    display: none;
  }

  .menu-toggle {
    width: 52px;
    height: 52px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    justify-self: end;
    position: relative;
    z-index: 97;
  }

  .menu-toggle-lines {
    position: relative;
    display: inline-flex;
    width: 26px;
    height: 18px;
  }

  .menu-toggle-lines span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast),
      top var(--transition-fast);
  }

  .menu-toggle-lines span:first-child {
    top: 3px;
  }

  .menu-toggle-lines span:last-child {
    top: 13px;
  }

  .site-header.menu-active .menu-toggle-lines span:first-child {
    top: 8px;
    transform: rotate(45deg);
  }

  .site-header.menu-active .menu-toggle-lines span:last-child {
    top: 8px;
    transform: rotate(-45deg);
  }

  .mobile-panel {
    position: fixed;
    top: var(--header-height);
    right: 0;
    bottom: 0;
    left: 0;
    background: var(--color-hero-red);
    color: var(--color-white);
    z-index: 85;
    overflow: auto;
    visibility: hidden;
    pointer-events: none;
    clip-path: inset(0 0 100% 0);
    transform: translateY(-12px);
    transition:
      clip-path 220ms ease,
      transform 220ms ease;
  }

  .mobile-panel.is-open {
    visibility: visible;
    pointer-events: auto;
    clip-path: inset(0 0 0 0);
    transform: translateY(0);
    transition:
      clip-path 220ms ease,
      transform 220ms ease;
  }

  .mobile-nav {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 28px;
    padding: 24px 18px 28px;
  }

  .mobile-nav-list {
    display: grid;
    gap: 10px;
  }

  .mobile-nav-list a,
  .mobile-follow,
  .mobile-contact-link {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 10px 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 7vw, 3rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-white);
  }

  .mobile-nav-list a[aria-current="page"] {
    color: rgba(255, 255, 255, 0.7);
  }

  .mobile-nav-list a:hover,
  .mobile-nav-list a:focus-visible,
  .mobile-follow:hover,
  .mobile-follow:focus-visible,
  .mobile-contact-link:hover,
  .mobile-contact-link:focus-visible {
    color: rgba(255, 255, 255, 0.76);
  }

  .mobile-contact {
    display: grid;
    gap: 10px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.26);
  }

  .mobile-follow {
    font-size: 1.05rem;
    font-family: var(--font-body);
    font-weight: 700;
    line-height: 1.2;
  }

  .mobile-contact-link {
    font-size: 0.96rem;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .site-header[data-scrolled="true"] {
    border-bottom-color: rgba(11, 28, 45, 0.2);
  }

  @media (max-width: 899px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
      column-gap: 12px;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle,
    .mobile-panel {
      display: block;
    }

    .brand-name {
      font-size: 1.15rem;
    }

    .brand-meta {
      display: none;
    }

    :global(.header-crest) {
      width: 92px;
    }
  }

  @media (max-width: 479px) {
    .header-inner {
      column-gap: 10px;
    }

    .brand {
      gap: 10px;
    }

    :global(.header-crest) {
      width: 84px;
    }

    .brand-name {
      font-size: 1rem;
    }
  }
</style>
