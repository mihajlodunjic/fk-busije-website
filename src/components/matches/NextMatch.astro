---
import type { MatchRecord } from "@/data/matches";
import { formatMatchDate } from "@/utils/dates";

type Props = {
  match?: MatchRecord;
  copy: {
    title: string;
    labels: Record<string, string>;
    empty: {
      title: string;
      text: string;
      cta: string;
    };
  };
  fallbackUrl: string;
};

const { match, copy, fallbackUrl } = Astro.props;

const teamPair = match?.homeTeam && match?.awayTeam ? `${match.homeTeam} — ${match.awayTeam}` : "";
const rows = match
  ? [
      { label: copy.labels.date, value: formatMatchDate(match.date) },
      match.time ? { label: copy.labels.time, value: match.time } : null,
      match.competition ? { label: copy.labels.competition, value: match.competition } : null,
      match.round ? { label: copy.labels.round, value: match.round } : null,
      match.venue ? { label: copy.labels.venue, value: match.venue } : null,
      match.homeTeam ? { label: copy.labels.home, value: match.homeTeam } : null,
      match.awayTeam ? { label: copy.labels.away, value: match.awayTeam } : null
    ].filter(Boolean)
  : [];
---

<article class="next-match">
  <div class="next-match-head">
    <h3>{copy.title}</h3>
    {teamPair && <p class="pairing">{teamPair}</p>}
  </div>

  {
    match ? (
      <dl class="match-grid">
        {rows.map((row) => row && (
          <div class="match-row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <div class="empty-state">
        <h4>{copy.empty.title}</h4>
        <p>{copy.empty.text}</p>
        <a
          class="button-secondary"
          href={fallbackUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${copy.empty.cta} (Отвара се у новом прозору)`}
        >
          {copy.empty.cta}
        </a>
      </div>
    )
  }
</article>

<style>
  .next-match {
    padding: 28px;
    border: 4px solid var(--color-club-blue);
    background: rgba(255, 255, 255, 0.26);
    box-shadow: var(--shadow-hard-blue);
  }

  .next-match-head {
    display: grid;
    gap: 10px;
    margin-bottom: 24px;
  }

  .next-match h3 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .pairing {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 3vw, 2rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .match-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 20px;
  }

  .match-row {
    display: grid;
    gap: 6px;
    padding-top: 12px;
    border-top: 1px solid rgba(11, 28, 45, 0.12);
  }

  .match-row dt {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .match-row dd {
    margin: 0;
    font-weight: 700;
    line-height: 1.4;
  }

  .empty-state {
    display: grid;
    gap: 14px;
    max-width: 38rem;
  }

  .empty-state h4 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.02;
  }

  @media (max-width: 767px) {
    .next-match {
      padding: 20px 18px;
      box-shadow: none;
    }

    .match-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
