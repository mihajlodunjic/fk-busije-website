---
import BlueMark from "@/components/brand/BlueMark.astro";
import ClubCrest from "@/components/brand/ClubCrest.astro";
import LocalMarker from "@/components/brand/LocalMarker.astro";
import ShieldDivider from "@/components/brand/ShieldDivider.astro";
import MatchResultsList from "@/components/matches/MatchResultsList.astro";
import NextMatch from "@/components/matches/NextMatch.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { business } from "@/data/business";
import { historyPreview } from "@/data/history";
import { homeCopy, matchesPageCopy } from "@/data/copy";
import { finishedMatches, upcomingMatches } from "@/data/matches";
import { publicSocialLinks } from "@/data/social";
import { sortFinished, sortUpcoming } from "@/utils/matches";

const instagramUrl = publicSocialLinks.find((item) => item.primary)?.url ?? "/";
const nextMatch = sortUpcoming(upcomingMatches)[0];
const recentResults = sortFinished(finishedMatches).slice(0, 4);
---

<BaseLayout
  title={homeCopy.seo.title}
  description={homeCopy.seo.description}
  pathname="/"
  currentPath="/"
  breadcrumbItems={[{ name: "Почетна", href: "/" }]}
>
  <script is:inline>
    document.documentElement.classList.add("hero-motion");
  </script>

  <section class="home-hero">
    <div class="home-hero-layout">
      <div class="hero-red-pane">
        <div class="hero-mark-shell hero-mark-top" aria-hidden="true">
          <BlueMark variant={1} />
        </div>
        <div class="hero-mark-shell hero-mark-bottom" aria-hidden="true">
          <BlueMark variant={3} />
        </div>
        <div class="hero-red-inner">
          <div class="hero-copy">
            <div class="hero-copy-top">
              <p class="eyebrow hero-meta hero-animate hero-animate-meta">{homeCopy.hero.metadata}</p>
              <p class="hero-tag hero-animate hero-animate-tag">{homeCopy.hero.marker}</p>
            </div>
            <h1 class="hero-animate hero-animate-title">{homeCopy.hero.title}</h1>
            <p class="lede hero-intro hero-animate hero-animate-intro">{homeCopy.hero.intro}</p>
            <div class="hero-actions">
              <a class="button-secondary hero-primary-link hero-action hero-animate hero-animate-action-primary" href="/klub/">
                {homeCopy.hero.primaryCta}
              </a>
              <a
                class="button-link hero-secondary-link hero-action hero-animate hero-animate-action-secondary"
                href={instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${homeCopy.hero.secondaryCta} (Отвара се у новом прозору)`}
              >
                {homeCopy.hero.secondaryCta}
              </a>
            </div>
          </div>

          <div class="hero-marker">
            <div class="hero-marker-reveal">
              <LocalMarker className="hero-local-marker" />
            </div>
          </div>
        </div>
      </div>

      <div class="hero-crest-pane">
        <div class="hero-crest-wrap">
          <ClubCrest className="hero-crest" loading="eager" size={596} />
        </div>
      </div>
    </div>
  </section>
  <ShieldDivider />

  <section class="section-shell identity-section">
    <div class="container grid-12 identity-grid" data-reveal>
      <div class="identity-meta">
        <p class="eyebrow">{homeCopy.identity.metadata}</p>
      </div>
      <div class="identity-title double-line ink">
        <h2>{homeCopy.identity.title}</h2>
      </div>
      <div class="identity-intro">
        <p class="body-large">{homeCopy.identity.intro}</p>
      </div>
    </div>

    <div class="container" data-reveal>
      <ul class="plain-list identity-facts">
        {
          homeCopy.identity.facts.map((fact) => (
            <li>
              <p class="eyebrow">{fact.label}</p>
              <p>{fact.value}</p>
            </li>
          ))
        }
      </ul>
      <a class="button-link identity-cta" href="/klub/">
        {homeCopy.identity.cta}
      </a>
    </div>
  </section>

  <section class="section-shell no-ground-section surface-blue">
    <span class="background-letter" aria-hidden="true">
      Б
    </span>
    <BlueMark variant={2} className="section-blue-mark" />
    <div class="container grid-12 no-ground-grid" data-reveal>
      <div class="no-ground-head">
        <p class="eyebrow">{homeCopy.noGround.metadata}</p>
        <h2>{homeCopy.noGround.title}</h2>
      </div>
      <div class="no-ground-body">
        {homeCopy.noGround.body.map((paragraph) => <p>{paragraph}</p>)}
        <a class="button-link no-ground-cta" href="/klub/">
          {homeCopy.noGround.cta}
        </a>
      </div>
    </div>
  </section>

  <section class="section-shell championship-section">
    <div class="container grid-12 championship-grid" data-reveal>
      <div class="championship-year-wrap">
        <p class="championship-year mono">{homeCopy.championship.year}</p>
      </div>
      <div class="championship-copy">
        <p class="eyebrow">{homeCopy.championship.metadata}</p>
        <h2>{homeCopy.championship.title}</h2>
        <p class="body-large">{homeCopy.championship.body}</p>
        <p class="championship-detail">{homeCopy.championship.detail}</p>
        <a class="button-link" href="/klub/#hronologija">
          {homeCopy.championship.cta}
        </a>
      </div>
    </div>
  </section>

  <section class="section-shell matches-section">
    <div class="container matches-header" data-reveal>
      <div class="section-header double-line ink">
        <p class="eyebrow">{homeCopy.matches.metadata}</p>
        <h2>{homeCopy.matches.title}</h2>
      </div>
      <p class="body-large">{homeCopy.matches.intro}</p>
    </div>

    <div class="container matches-module" data-reveal>
      <NextMatch match={nextMatch} copy={homeCopy.matches} fallbackUrl={instagramUrl} />
      <MatchResultsList matches={recentResults} copy={matchesPageCopy.results} fallbackUrl={instagramUrl} />
      <a class="button-link home-matches-link" href="/utakmice/">
        {homeCopy.matches.cta}
      </a>
    </div>
  </section>

  <section class="section-shell timeline-section">
    <div class="container grid-12 timeline-grid" data-reveal>
      <div class="timeline-intro">
        <p class="eyebrow">{homeCopy.timeline.metadata}</p>
        <h2>{homeCopy.timeline.title}</h2>
      </div>
      <div class="timeline-list">
        <ul class="plain-list">
          {historyPreview.map((item) => (
            <li class="timeline-row">
              <p class="timeline-year mono">{item.year}</p>
              <p class="timeline-text">{item.text}</p>
            </li>
          ))}
        </ul>
        <a class="button-link" href="/klub/">
          {homeCopy.timeline.cta}
        </a>
      </div>
    </div>
  </section>

  <section class="section-shell contact-band surface-red">
    <div class="container grid-12 contact-band-grid" data-reveal>
      <div class="contact-band-copy">
        <p class="eyebrow">{homeCopy.contactBand.metadata}</p>
        <h2>{homeCopy.contactBand.title}</h2>
        <p class="lede">{homeCopy.contactBand.intro}</p>
      </div>
      <div class="contact-band-actions">
        <a
          class="contact-band-link contact-band-link-strong"
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${homeCopy.contactBand.ctas.instagram} (Отвара се у новом прозору)`}
        >
          {homeCopy.contactBand.ctas.instagram}
        </a>
        <a class="contact-band-link" href={business.contact.phoneHref}>
          {homeCopy.contactBand.ctas.phone}
        </a>
        <a class="contact-band-link" href={business.contact.emailHref}>
          {homeCopy.contactBand.ctas.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    --hero-header-offset: 104px;
    position: relative;
    overflow: clip;
    background: var(--color-paper);
    height: min(760px, calc(100vh - var(--hero-header-offset)));
    height: min(760px, calc(100svh - var(--hero-header-offset)));
    min-height: 0;
    max-height: 760px;
    isolation: isolate;
  }

  @supports (height: 100dvh) {
    .home-hero {
      height: min(760px, calc(100dvh - var(--hero-header-offset)));
    }
  }

  .home-hero-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(320px, 0.82fr);
    align-items: stretch;
    height: 100%;
  }

  .hero-red-pane,
  .hero-crest-pane {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }

  .hero-red-pane {
    background: var(--color-hero-red);
  }

  .hero-red-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    height: 100%;
    padding:
      clamp(24px, 4svh, 40px)
      clamp(18px, 4.5vw, 64px)
      clamp(22px, 4svh, 38px);
  }

  .hero-crest-pane {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-paper);
  }

  .hero-crest-pane::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--color-club-blue);
    z-index: 3;
    transform-origin: center top;
  }

  .hero-copy {
    position: relative;
    z-index: 4;
    display: grid;
    align-content: center;
    gap: clamp(8px, 1.2svh, 14px);
    align-self: center;
    max-width: min(100%, 33rem);
  }

  .hero-copy-top {
    display: grid;
    gap: 8px;
  }

  .hero-meta,
  .hero-tag {
    color: rgba(255, 255, 255, 0.82);
    max-width: none;
  }

  .hero-tag {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 7.3ch;
    color: var(--color-white);
    font-size: clamp(3.05rem, 5.5vw, 5.5rem);
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  .hero-intro {
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(1rem, 1.2vw + 0.5rem, 1.28rem);
    line-height: 1.45;
    max-width: 30rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    padding-top: 6px;
  }

  .hero-action {
    width: fit-content;
  }

  .hero-primary-link {
    border-color: rgba(255, 255, 255, 0.92);
    color: var(--color-white);
  }

  .hero-primary-link:hover,
  .hero-primary-link:focus-visible {
    background: var(--color-white);
    color: var(--color-hero-red);
  }

  .hero-secondary-link {
    color: var(--color-white);
  }

  .hero-crest-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding:
      clamp(28px, 4svh, 56px)
      clamp(18px, 3.6vw, 48px);
  }

  :global(.hero-crest) {
    --crest-size: clamp(300px, 30vw, 440px) !important;
    width: var(--crest-size);
    max-width: min(100%, 440px);
    position: relative;
    z-index: 2;
    margin-inline: auto;
  }

  .hero-mark-shell {
    position: absolute;
    z-index: 1;
    aspect-ratio: 46 / 11;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-mark-shell :global(.blue-mark) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgba(14, 84, 157, 0.88);
    opacity: 0.92;
  }

  .hero-mark-top {
    top: clamp(22px, 7%, 52px);
    right: clamp(16px, 6%, 62px);
    width: clamp(150px, 17vw, 250px);
  }

  .hero-mark-bottom {
    right: clamp(18px, 5%, 56px);
    bottom: clamp(24px, 10%, 64px);
    width: clamp(112px, 12vw, 190px);
  }

  .hero-marker {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    height: 100%;
    padding-block: 6px;
  }

  .hero-marker-reveal {
    overflow: hidden;
  }

  :global(.hero-local-marker) {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.74);
  }

  html.hero-motion .hero-red-pane {
    clip-path: inset(0 100% 0 0);
    animation: hero-panel-left 360ms cubic-bezier(0.24, 0.84, 0.32, 1) forwards;
  }

  html.hero-motion .hero-crest-pane {
    clip-path: inset(0 0 0 100%);
    animation: hero-panel-right 400ms cubic-bezier(0.22, 0.86, 0.24, 1) 40ms forwards;
  }

  html.hero-motion .hero-crest-pane::before {
    transform: scaleY(0);
    animation: hero-divider-vertical 220ms cubic-bezier(0.2, 0.8, 0.2, 1) 240ms forwards;
  }

  html.hero-motion .hero-mark-shell {
    opacity: 0;
    clip-path: inset(0 100% 0 0);
  }

  html.hero-motion .hero-mark-top {
    animation: hero-mark-swipe 220ms cubic-bezier(0.2, 0.8, 0.2, 1) 230ms forwards;
  }

  html.hero-motion .hero-mark-bottom {
    animation: hero-mark-swipe 220ms cubic-bezier(0.2, 0.8, 0.2, 1) 310ms forwards;
  }

  html.hero-motion .hero-animate {
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transform: translate3d(0, 18px, 0);
    animation: hero-text-wipe 360ms cubic-bezier(0.2, 0.82, 0.25, 1) forwards;
  }

  html.hero-motion .hero-animate-meta {
    animation-delay: 160ms;
  }

  html.hero-motion .hero-animate-tag {
    animation-delay: 210ms;
  }

  html.hero-motion .hero-animate-title {
    animation-delay: 240ms;
    animation-duration: 380ms;
  }

  html.hero-motion .hero-animate-intro {
    animation-delay: 320ms;
  }

  html.hero-motion .hero-animate-action-primary {
    animation-delay: 420ms;
  }

  html.hero-motion .hero-animate-action-secondary {
    animation-delay: 500ms;
  }

  html.hero-motion :global(.hero-crest) {
    opacity: 0;
    transform: translate3d(18px, 0, 0) scale(0.88);
    animation: hero-crest-in 460ms cubic-bezier(0.16, 1, 0.3, 1) 220ms forwards;
  }

  html.hero-motion .hero-marker-reveal {
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    animation: hero-marker-wipe 220ms linear 640ms forwards;
  }

  @keyframes hero-panel-left {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-panel-right {
    from {
      clip-path: inset(0 0 0 100%);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-divider-vertical {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }

  @keyframes hero-divider-horizontal {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes hero-mark-swipe {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
    }

    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-text-wipe {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transform: translate3d(0, 18px, 0);
    }

    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes hero-crest-in {
    from {
      opacity: 0;
      transform: translate3d(18px, 0, 0) scale(0.88);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes hero-marker-wipe {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
    }

    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.hero-motion .home-hero *,
    html.hero-motion .home-hero *::before,
    html.hero-motion .home-hero *::after {
      animation: none !important;
      clip-path: none !important;
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  .identity-grid {
    align-items: start;
    margin-bottom: 36px;
  }

  .identity-meta {
    grid-column: span 2;
  }

  .identity-title {
    grid-column: span 5;
  }

  .identity-title h2 {
    max-width: 10ch;
    overflow-wrap: anywhere;
  }

  .identity-intro {
    grid-column: span 5;
  }

  .identity-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 24px;
    border-top: 2px solid var(--color-ink);
  }

  .identity-facts li {
    display: grid;
    gap: 8px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(11, 28, 45, 0.16);
  }

  .identity-facts p:last-child {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    line-height: 1;
  }

  .identity-cta {
    margin-top: 20px;
  }

  .no-ground-section {
    overflow: clip;
  }

  .no-ground-grid {
    position: relative;
    align-items: start;
  }

  .no-ground-head {
    grid-column: span 5;
    display: grid;
    gap: 14px;
  }

  .no-ground-body {
    grid-column: span 7;
    display: grid;
    gap: 18px;
    position: relative;
    z-index: 2;
  }

  .no-ground-body p {
    color: rgba(255, 255, 255, 0.94);
  }

  .background-letter {
    position: absolute;
    top: -22px;
    right: clamp(12px, 8vw, 110px);
    font-family: var(--font-heading);
    font-size: clamp(14rem, 34vw, 26rem);
    line-height: 0.82;
    color: rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  :global(.section-blue-mark) {
    position: absolute;
    width: clamp(260px, 28vw, 440px);
    right: clamp(-30px, 2vw, 20px);
    bottom: 32px;
    color: rgba(255, 255, 255, 0.14);
  }

  .no-ground-cta {
    color: var(--color-white);
    width: fit-content;
  }

  .championship-grid {
    align-items: start;
    grid-template-columns: minmax(220px, 0.88fr) minmax(0, 1.12fr);
    column-gap: clamp(24px, 4vw, 64px);
  }

  .championship-year-wrap {
    grid-column: auto;
    position: relative;
    max-width: 360px;
    padding-bottom: 26px;
    padding-right: clamp(16px, 3vw, 40px);
  }

  .championship-year {
    position: relative;
    z-index: 2;
    font-size: clamp(3.75rem, 7vw, 6rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    color: var(--color-ink);
  }

  .championship-year-wrap::after {
    content: "";
    position: absolute;
    width: clamp(104px, 12vw, 168px);
    height: 4px;
    left: 0;
    bottom: 0;
    background: rgba(14, 84, 157, 0.24);
  }

  .championship-copy {
    grid-column: auto;
    display: grid;
    gap: 16px;
    position: relative;
    z-index: 2;
  }

  .championship-detail {
    font-weight: 700;
  }

  .matches-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: end;
    margin-bottom: 36px;
  }

  .matches-module {
    display: grid;
    gap: 28px;
  }

  .home-matches-link {
    justify-self: start;
  }

  .timeline-grid {
    align-items: start;
  }

  .timeline-intro {
    grid-column: span 4;
    display: grid;
    gap: 14px;
  }

  .timeline-list {
    grid-column: span 8;
    display: grid;
    gap: 22px;
  }

  .timeline-row {
    display: grid;
    grid-template-columns: minmax(90px, 110px) minmax(0, 1fr);
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid rgba(11, 28, 45, 0.16);
  }

  .timeline-row:last-child {
    border-bottom: 1px solid rgba(11, 28, 45, 0.16);
  }

  .timeline-year {
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-club-blue);
  }

  .contact-band {
    overflow: clip;
  }

  .contact-band-grid {
    align-items: start;
  }

  .contact-band-copy {
    grid-column: span 6;
    display: grid;
    gap: 14px;
  }

  .contact-band-copy h2,
  .contact-band-copy p {
    color: var(--color-white);
  }

  .contact-band-actions {
    grid-column: span 6;
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .contact-band-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 6px 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.6vw, 1.8rem);
    line-height: 1;
    letter-spacing: -0.02em;
    border-bottom: 2px solid rgba(255, 255, 255, 0.32);
  }

  .contact-band-link-strong {
    border-bottom-color: rgba(255, 255, 255, 0.88);
  }

  @media (max-width: 1023px) {
    .identity-grid,
    .no-ground-grid,
    .championship-grid,
    .timeline-grid,
    .contact-band-grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .home-hero-layout {
      grid-template-columns: minmax(0, 1.08fr) minmax(260px, 0.76fr);
    }

    .hero-red-inner {
      padding:
        clamp(22px, 3.8svh, 34px)
        clamp(22px, 4vw, 40px)
        clamp(20px, 3.6svh, 32px);
    }

    .home-hero h1 {
      font-size: clamp(2.9rem, 5.6vw, 4.8rem);
    }

    .hero-intro {
      max-width: 28rem;
    }

    :global(.hero-crest) {
      --crest-size: clamp(260px, 30vw, 360px) !important;
      max-width: min(100%, 360px);
