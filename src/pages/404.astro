---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { notFoundCopy } from "@/data/copy";
---

<BaseLayout
  title={notFoundCopy.seoTitle}
  description={notFoundCopy.text}
  pathname="/404.html"
  currentPath=""
  breadcrumbItems={[{ name: "Почетна", href: "/" }, { name: "404", href: "/404.html" }]}
>
  <section class="not-found surface-red">
    <div class="container not-found-inner" data-reveal>
      <p class="eyebrow">{notFoundCopy.metadata}</p>
      <h1>{notFoundCopy.title}</h1>
      <p class="lede">{notFoundCopy.text}</p>
      <div class="not-found-actions">
        <a class="button-secondary not-found-primary" href="/">
          {notFoundCopy.primary}
        </a>
        <a class="button-link not-found-secondary" href="/utakmice/">
          {notFoundCopy.secondary}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
  }

  .not-found-inner {
    display: grid;
    gap: 16px;
    padding-block: 56px;
  }

  .not-found h1,
  .not-found p {
    color: var(--color-white);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    align-items: center;
  }

  .not-found-primary {
    border-color: rgba(255, 255, 255, 0.92);
    color: var(--color-white);
  }

  .not-found-primary:hover,
  .not-found-primary:focus-visible {
    background: var(--color-white);
    color: var(--color-club-red);
  }

  .not-found-secondary {
    color: var(--color-white);
  }
</style>
